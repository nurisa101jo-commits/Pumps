{
  "name":"@pumps/admin-desktop",
  "version":"1.0.1",
  "private":true,
  "type":"module",
  "main":"dist/main.js",
  "scripts":{
    "build":"tsc -p tsconfig.json && node scripts/bundle-api.mjs && node scripts/copy-assets.mjs",
    "package":"electron-builder --win"
  },
  "dependencies":{
    "@pumps/admin":"workspace:*",
    "@pumps/api":"workspace:*",
    "@pumps/db":"workspace:*"
  },
  "devDependencies":{
    "electron-builder":"^26.0.12",
    "typescript":"^5.9.2",
    "esbuild":"^0.28.2",
    "electron":"^38.2.0"
  },
  "build":{
    "appId":"com.company.pumps.admin",
    "productName":"Pumps Admin",
    "directories":{"output":"release"},
    "files":["dist/main.js","package.json"],
    "extraResources":[
      {"from":"dist/api/server.js","to":"api/server.js"},
      {"from":"dist/api/migrations","to":"api/migrations"},
      {"from":"dist/admin","to":"admin"}
    ]
  },
  "description":"Pumps Platform Administration Portal",
  "author":"Company Pumps Platform"
}