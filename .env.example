# API
PORT=4000

# PostgreSQL (optional; omit DATABASE_URL for in-memory inspection)
DATABASE_URL=postgresql://pumps:pumps@localhost:5432/pumps
RUN_MIGRATIONS=true
MIGRATIONS_DIR=./packages/db/dist/migrations

# Backups
BACKUP_DIR=./backups
AUTOMATIC_BACKUP_HOURS=24

# AI ingestion (required only for AI import)
# AI_INGESTION_URL=http://localhost:5000/extract
# AI_INGESTION_API_KEY=

# Frontend API URLs (optional; defaults are localhost:4000)
# VITE_API_URL=http://localhost:4000
