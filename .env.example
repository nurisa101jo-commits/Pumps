# API
PORT=4000

# PostgreSQL (optional; omit DATABASE_URL for in-memory inspection)
DATABASE_URL=postgresql://pumps:pumps@localhost:5432/pumps
RUN_MIGRATIONS=true
MIGRATIONS_DIR=./packages/db/dist/migrations

# Backups
BACKUP_DIR=./backups
AUTOMATIC_BACKUP_HOURS=24


# Demo catalog (development/inspection only; never enable in production)
SEED_DEMO=true

+# Authentication\nAUTH_REQUIRED=false\n# Set true in production and configure secure bearer tokens.\n# ADMIN_API_TOKEN=\n# ENGINEER_API_TOKEN=\n# CUSTOMER_API_TOKEN=\n\n# Upload limit\nMAX_UPLOAD_MB=25\n\n# AI ingestion (required only for AI import)
# AI_INGESTION_URL=http://localhost:5000/extract
# AI_INGESTION_API_KEY=

# Frontend API URLs (optional; defaults are localhost:4000)
# VITE_API_URL=http://localhost:4000
